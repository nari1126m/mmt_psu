
นำเข้า "type.json"
ส่งออก โปรแกรม abs(x):
   ถ้า(x >= 0):
     คืนค่า x
   คืนค่า -x

ส่งออก โปรแกรม gcd(a,b):
        ถ้า a = 0:
                คืนค่า b
        คืนค่า gcd(b%a,a)


ส่งออก โปรแกรม จำนวนเฉพาะ(n):
    prime คือ []
    ans คือ []
    สำหรับ i ในช่วง(n+1):
        prime.เพิ่ม(จริง)
    สำหรับ p ในช่วง(2,เปลี่ยนจำนวนเต็ม(2 ราก n) + 1):
        ถ้า prime[p]:
            สำหรับ i ในช่วง(p*p , n+1 , p):
                prime[i] คือ เท็จ
    สำหรับ i ในช่วง(2,n):
        ถ้า prime[i] = จริง:
            ans.เพิ่ม(i)
    คืนค่า ans